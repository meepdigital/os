{
  "name": "ubuntu-meep-installer",
  "version": "0.1.0",
  "description": "Ubuntu Meep graphical installer",
  "private": true,
  "license": "ISC",
  "author": "Meep Digital",
  "main": "dist/main.js",
  "scripts": {
    "build": "webpack --config src/main/webpack.config.js --mode production",
    "build:dev": "webpack --config src/main/webpack.config.js --mode development",
    "watch": "nodemon --watch . --ignore node_modules --ignore dist --ext js,html,scss,json,sh,css,png --delay 500ms --exec \"npm run build:dev && npm start\"",
    "build:watch": "webpack --config src/main/webpack.config.js --mode development --watch",
    "start": "bash ./sh/start",
    "start:dev": "webpack --config src/main/webpack.config.js --mode development && bash ./sh/start",
    "lint": "node --check src/main/main.js && node --check src/main/preload.js && node --check src/main/renderer.js && node --check src/disk/shell.js && node --check src/disk/filter.js && node --check src/disk/list.js && node --check src/drivers/collect.js",
    "desktop": "bash ./sh/install"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@popperjs/core": "^2.11.8",
    "angular": "^1.8.3",
    "angular-animate": "^1.8.3",
    "angular-sanitize": "^1.8.3",
    "angular-ui-bootstrap": "^2.5.6",
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "electron": "^38.1.0",
    "mini-css-extract-plugin": "^2.9.2",
    "nodemon": "^3.1.14",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  }
}
