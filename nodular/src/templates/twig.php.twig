<?php
require_once __DIR__ . '/../../../vendor/autoload.php';

function render($entry, $options = []) {
    $root = $options['root'] ?? dirname($entry);
    $loader = new \Twig\Loader\FilesystemLoader($root);
    $twig = new \Twig\Environment($loader, ['autoescape' => 'name', 'strict_variables' => true]);

    // Extension files may register directly on $twig, return a registration
    // callable, or return a Twig ExtensionInterface (or an array of extensions).
    $extensionRoot = __DIR__ . '/../../../{{ extension_directory }}';
    $files = [];
    if (is_dir($extensionRoot)) {
        $iterator = new \RecursiveIteratorIterator(new \RecursiveDirectoryIterator(
            $extensionRoot, \FilesystemIterator::SKIP_DOTS
        ));
        foreach ($iterator as $file) {
            if ($file->isFile() && $file->getExtension() === 'php') $files[] = $file->getPathname();
        }
    }
    sort($files, SORT_STRING);
    foreach ($files as $file) {
        $extension = include $file;
        if (is_callable($extension)) $extension($twig);
        elseif ($extension instanceof \Twig\Extension\ExtensionInterface) $twig->addExtension($extension);
        elseif (is_array($extension)) {
            foreach ($extension as $item) $twig->addExtension($item);
        }
    }
    foreach ($options['extensions'] ?? [] as $extension) {
        require_once $extension['file'];
        $extension['func']($twig);
    }
    $name = substr($entry, strlen(rtrim($root, '/')) + 1);
    return $twig->render($name, $options['context'] ?? []);
}
